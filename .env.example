# Public application configuration
APP_NAME=VCStudio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk browser-visible configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Clerk server-only configuration
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon PostgreSQL server-only configuration
# Use the pooled URL at application runtime.
DATABASE_URL=
# Prefer the direct/unpooled URL for migrations.
DATABASE_URL_UNPOOLED=
# Opt in only when running the isolated development-database invariant suite.
RUN_DATABASE_INTEGRATION_TESTS=false

# Cloudflare R2 private object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_SIGNED_UPLOAD_EXPIRY_SECONDS=300
R2_SIGNED_DOWNLOAD_EXPIRY_SECONDS=300

# Phase 4 character reference uploads
MAX_CHARACTER_REFERENCE_SIZE_BYTES=5242880
ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp
MIN_REFERENCE_IMAGE_WIDTH=512
MIN_REFERENCE_IMAGE_HEIGHT=512
MAX_REFERENCE_IMAGE_WIDTH=4096
MAX_REFERENCE_IMAGE_HEIGHT=4096
ENABLE_CHARACTER_LIBRARY=true

# Manual scene media uploads (uploaded scene images, recorded narration) —
# free, synchronous uploads, separate from the paid AI generation limits above.
MAX_SCENE_IMAGE_UPLOAD_SIZE_BYTES=10485760
ALLOWED_SCENE_IMAGE_UPLOAD_MIME_TYPES=image/png,image/jpeg,image/webp
MAX_SCENE_AUDIO_UPLOAD_SIZE_BYTES=15728640
ALLOWED_SCENE_AUDIO_UPLOAD_MIME_TYPES=audio/webm,audio/mp4

# Workspace media library — reusable images and videos for social posts. Larger
# than the per-scene upload ceilings above because these are finished assets.
# The duration ceiling is advisory: the web runtime has no ffprobe, so duration
# is reported by the browser and each platform re-validates it when publishing.
MAX_MEDIA_IMAGE_BYTES=26214400
MAX_MEDIA_VIDEO_BYTES=536870912
MAX_MEDIA_VIDEO_DURATION_SECONDS=3600

# Social posting. LinkedIn and X credentials are optional like every other
# platform's, so a workspace without either app cannot break Facebook or YouTube.
# ENABLE_SOCIAL_POST_SIMULATION makes every platform return a synthetic success
# with no network call — useful while app approval is pending. It must
# be false in production, or a "published" post would never actually exist.
# The asset URL TTL must exceed the publish task's wall clock: Meta fetches image
# URLs itself, so a URL that expires mid-job fails the post.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn retires REST versions on a rolling ~1 year schedule, and a retired
# value fails EVERY request with 426 rather than degrading. Review periodically.
LINKEDIN_API_VERSION=202607
# X (Twitter). Named TWITTER_* because that is what X's developer portal, token
# endpoints, and the stored `content_platform` value still call it — only the
# user-facing label is "X". Needed in BOTH runtimes: the web app runs the connect
# flow, and the worker refreshes access tokens, which X expires after ~2 hours.
# The registered callback URL is /api/x/callback, derived from APP_BASE_URL.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
ENABLE_SOCIAL_POSTING=true
ENABLE_SOCIAL_POST_SIMULATION=false
SOCIAL_POST_ASSET_URL_TTL_SECONDS=3600
SOCIAL_SCHEDULER_BATCH_SIZE=25

# Marketing Studio (docs/marketing/). Gates the whole /app/marketing segment and,
# once they exist, the scheduled marketing sweeps. Needed in BOTH runtimes — a
# flag honoured only in the web app would leave the worker still running.
# Defaults to false; the feature is incomplete until its slices land.
ENABLE_MARKETING_STUDIO=false
# Knowledge-corpus ceilings. MARKETING_MAX_DOCUMENTS is also the documented
# threshold past which a vector store stops being over-engineering.
MARKETING_MAX_DOCUMENTS=200
MARKETING_MAX_DOCUMENT_BYTES=2097152
# Ceiling for the compiled brand context block. Documents are dropped to fit,
# lowest priority first, and the block states how many were omitted. Identity,
# voice, banned phrases and compliance notes are never dropped.
MARKETING_BRAND_CONTEXT_MAX_TOKENS=2500

# Project and script limits
MAX_SCRIPT_CHARACTERS=50000
DEFAULT_PROJECT_BUDGET_CENTS=500

# Phase 3 scene analysis (server only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TEXT_INPUT_COST_PER_MILLION_CENTS=100
OPENAI_TEXT_OUTPUT_COST_PER_MILLION_CENTS=600
OPENAI_REQUEST_TIMEOUT_SECONDS=180
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
IDEMPOTENCY_HASH_SECRET=
REQUEST_FINGERPRINT_SECRET=
MAX_SCENES_PER_PROJECT=200
# Idea Lab: max idea cards produced per one-shot generation (server only). The
# generator is a sub-cent text call kept off the usage-reservation ledger and
# guarded by the shared generation rate limit; it reuses the OPENAI_TEXT_* text
# model and cost settings above.
MAX_IDEAS_PER_BATCH=5
MIN_SCENE_DURATION_MILLISECONDS=1000
MAX_SCENE_DURATION_MILLISECONDS=60000
MAX_SCENE_ANALYSIS_RETRIES=2
GENERATION_RESERVATION_EXPIRY_MINUTES=30
DEFAULT_DAILY_BUDGET_CENTS=500
DEFAULT_MONTHLY_BUDGET_CENTS=5000

# Phase 5 scene image generation (server and Trigger.dev)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_DRAFT_QUALITY=low
OPENAI_IMAGE_FINAL_QUALITY=medium
OPENAI_IMAGE_OUTPUT_FORMAT=webp
OPENAI_IMAGE_DRAFT_COMPRESSION=80
OPENAI_IMAGE_FINAL_COMPRESSION=90
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_IMAGE_TEXT_INPUT_COST_PER_MILLION_CENTS=500
OPENAI_IMAGE_INPUT_COST_PER_MILLION_CENTS=800
OPENAI_IMAGE_OUTPUT_COST_PER_MILLION_CENTS=3000
OPENAI_IMAGE_LOW_SQUARE_ESTIMATE_CENTS=2
OPENAI_IMAGE_LOW_RECTANGULAR_ESTIMATE_CENTS=2
OPENAI_IMAGE_MEDIUM_SQUARE_ESTIMATE_CENTS=6
OPENAI_IMAGE_MEDIUM_RECTANGULAR_ESTIMATE_CENTS=7
OPENAI_IMAGE_HIGH_SQUARE_ESTIMATE_CENTS=20
OPENAI_IMAGE_HIGH_RECTANGULAR_ESTIMATE_CENTS=25
OPENAI_IMAGE_REFERENCE_RESERVE_CENTS_PER_ASSET=1
MAX_IMAGE_GENERATION_RETRIES=1
MAX_REFERENCE_ASSETS_PER_GENERATION=8
MAX_REFERENCE_BYTES_PER_GENERATION=20971520
MAX_IMAGE_GENERATIONS_PER_SCENE_VERSION=50
ENABLE_SCENE_IMAGE_GENERATION=true

# Phase 6 storyboard bulk image generation (server only)
MAX_IMAGES_PER_BATCH=25
# Phase 7 scene narration audio generation (server and Trigger.dev)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_SPEED_SCALED_PERCENT=100
OPENAI_TTS_COST_PER_MILLION_CHARACTERS_CENTS=1500
OPENAI_TTS_MINIMUM_ESTIMATE_CENTS=1
MAX_AUDIO_GENERATION_RETRIES=1
MAX_AUDIO_GENERATIONS_PER_SCENE_VERSION=50
MAX_SCENES_PER_AUDIO_BATCH=25
MAX_NARRATION_CHARACTERS=4000
AUDIO_SCENE_PADDING_MILLISECONDS=250
FFPROBE_PATH=ffprobe
ENABLE_SCENE_AUDIO_GENERATION=true

# Phase 8 subtitles and timeline (Vercel web runtime only)
SUBTITLE_MAX_LINE_CHARACTERS=42
SUBTITLE_MIN_SEGMENT_DURATION_MILLISECONDS=700
SUBTITLE_MAX_SEGMENT_DURATION_MILLISECONDS=7000
SUBTITLE_DURATION_MISMATCH_TOLERANCE_MILLISECONDS=1500
ENABLE_SUBTITLES=true

# Phase 9 video preview and rendering
# Shared cost/limit/enable values go to BOTH Vercel and Trigger.dev and must
# match. The encoder/browser settings (concurrency, timeout, CRF, JPEG quality,
# Chromium path) are Trigger.dev worker only.
ENABLE_VIDEO_RENDERING=true
VIDEO_RENDER_COST_PER_MINUTE_CENTS=5
VIDEO_RENDER_MINIMUM_ESTIMATE_CENTS=5
MAX_RENDER_DURATION_SECONDS=900
MAX_RENDER_ATTEMPTS=2
VIDEO_RENDER_RESERVATION_EXPIRY_MINUTES=60
VIDEO_WATERMARK_ENABLED=false
VIDEO_WATERMARK_TEXT=
# Signed URL lifetime for the in-browser preview player (web runtime only).
VIDEO_PREVIEW_URL_EXPIRY_SECONDS=3600
VIDEO_RENDER_CONCURRENCY=1
VIDEO_RENDER_TIMEOUT_SECONDS=1800
VIDEO_RENDER_CRF=18
VIDEO_RENDER_JPEG_QUALITY=80
# REMOTION_CHROMIUM_EXECUTABLE=
FFMPEG_PATH=ffmpeg

# Phase 10 usage, budgets, and audit (Vercel web runtime only)
# The web runtime resolves a workspace's effective budgets (the editable
# workspace_budget_settings row, falling back to DEFAULT_DAILY/MONTHLY above) and
# decides whether an estimate crosses the manual-confirmation threshold, so this
# is a Vercel-only preflight/UX value that no Trigger.dev worker reads.
MANUAL_CONFIRMATION_THRESHOLD_CENTS=100
# Per-workspace fixed-window rate limiting for billable operations (web runtime).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERATIONS_PER_WINDOW=30
RATE_LIMIT_RENDERS_PER_WINDOW=10
# Marketing chat gets its own ceiling. A conversation is chatty by nature, so a
# user sending ten messages in a minute is ordinary use, not abuse — sharing the
# generation limit above would refuse normal work. Other marketing operations
# (content, images, research) share RATE_LIMIT_GENERATIONS_PER_WINDOW.
RATE_LIMIT_MARKETING_CHAT_PER_WINDOW=20

# Platform publishing — uploading a finished render to an external platform.
# YouTube ships first; Facebook/Instagram/TikTok reuse the same connection and
# publication tables and add their own OAuth client block here.
#
# Public origin used to build OAuth redirect URIs. It MUST match a redirect URI
# registered on the OAuth client, e.g. {APP_BASE_URL}/api/youtube/callback.
APP_BASE_URL=http://localhost:3000
# 32 bytes, base64 or hex. Encrypts platform OAuth access/refresh tokens at rest
# (AES-256-GCM). Generate with: openssl rand -base64 32
# Rotating this invalidates every stored connection — users must reconnect.
PLATFORM_TOKEN_ENCRYPTION_KEY=
# Signs the OAuth `state` parameter so a callback cannot be forged or replayed.
# Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECONDS=600
# Per-platform app credentials are optional and validated lazily: a platform is
# only usable once its own credentials are set, but a missing one no longer
# breaks the others. Every credentialed runtime (Vercel AND Trigger.dev) that
# should publish to a platform must have that platform's vars.
#
# Google Cloud OAuth 2.0 **web** client (NOT a service account — a service
# account has no YouTube channel and cannot upload to one). Enables YouTube.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Meta app credentials are required only in the Vercel/web runtime.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Shared by Vercel and Trigger.dev. Pin this for reproducible API behavior.
FACEBOOK_GRAPH_API_VERSION=v25.0
# Direct Instagram Login credentials are Vercel/web-only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Shared by Vercel and Trigger.dev for OAuth profile and Reel publishing calls.
INSTAGRAM_GRAPH_API_VERSION=v25.0
TIKTOK_API_CLIENT_KEY=
TIKTOK_API_CLIENT_SECRET=
ENABLE_VIDEO_PUBLISHING=true
MAX_PUBLISH_VIDEO_BYTES=1073741824
# Must exceed the publish task's wall clock or the R2 download URL expires
# mid-upload (the same failure mode that previously stalled long renders).
PUBLISH_ASSET_URL_TTL_SECONDS=3600

# Publishing simulation (LOCAL TESTING / DEMO ONLY). When true, every platform is
# served by a simulator that ramps upload progress and returns a synthetic
# success WITHOUT calling any real platform API — so the publish flow can be
# exercised without live accounts, tokens, or a publicly reachable video. The
# Trigger.dev worker must still be running (`npx trigger.dev dev` in dev) for the
# task to execute. MUST be false in production.
ENABLE_PUBLISH_SIMULATION=false
PUBLISH_SIMULATION_STEP_MS=600

# --- 2026-08-04 · Marketing Studio, Slice 5 (chat) -------------------------
# The chat model is deliberately separate from OPENAI_TEXT_MODEL: scene analysis
# wants the strongest structured-output model, while a conversation is judged on
# latency too and is billed per turn. Its rates are separate for the same
# reason — recording chat spend at another model's price is how a ledger quietly
# stops adding up, so change these together.
MARKETING_CHAT_MODEL=gpt-5.6-luna
MARKETING_CHAT_INPUT_COST_PER_MILLION_CENTS=100
MARKETING_CHAT_OUTPUT_COST_PER_MILLION_CENTS=600
# One step is a model call plus its tool calls. A step limit alone does not
# bound cost, which is what MARKETING_CHAT_MAX_TURN_COST_CENTS is for: crossing
# it drops the billable tools from the next step so the model must summarise and
# stop, rather than aborting an answer the user has already paid for.
MARKETING_CHAT_MAX_STEPS=6
MARKETING_CHAT_MAX_TURN_COST_CENTS=25
# How many prior turns are replayed. History is reloaded in full every turn, so
# an unbounded thread would grow its own input cost without limit.
MARKETING_CHAT_HISTORY_MESSAGES=40
