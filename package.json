{
  "name": "content-creation-tool",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "proxy-addr": "2.0.8",
    "cookie@<0.7.0": "0.7.2",
    "ws@8.0.0 - 8.20.1": "8.21.1",
    "tar@<7.5.22": "7.5.22"
  },
  "scripts": {
    "mcp:build": "node scripts/build-mcp-widget.mjs",
    "prebuild": "npm run mcp:build",
    "predev": "npm run mcp:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mcp": "playwright test --config playwright.mcp.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "node scripts/check-env-placement.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.29",
    "@ai-sdk/react": "4.0.54",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.18",
    "@clerk/ui": "^1.25.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@remotion/bundler": "4.0.491",
    "@remotion/player": "4.0.491",
    "@remotion/renderer": "4.0.491",
    "@studio/contracts": "file:packages/contracts",
    "@studio/prompts": "file:packages/prompts",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@trigger.dev/build": "4.8.3",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "7.0.51",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.11.0",
    "next": "16.4.5",
    "openai": "^6.47.0",
    "pdfjs-dist": "^5.4.149",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.491",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.19",
    "@electric-sql/pglite": "0.3.15",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^1.0.0-rc.4",
    "esbuild": "0.27.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "trigger.dev": "4.8.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
